---
import Shell from './Shell.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import { strings, type Lang } from '../i18n/landing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const link = (href: string) => (href.startsWith('http') || href.startsWith('/') ? href : `${t.prefix}/${href}`);

// A page thumbnail is a few grey bars. Widths come from a fixed seed so every build looks the same.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const page = () => {
  const n = 3 + Math.floor(rand() * 4);
  return Array.from({ length: n }, (_, i) => (i === 0 ? 45 + rand() * 30 : 55 + rand() * 45));
};
const kinds = ['pdf', 'pdf', 'ed', 'pdf', 'rec', 'web', 'pdf', 'ed'];

// Hero wall: 7 x 5 pages, one of them lit.
const HERO_HIT = 17;
const heroPages = Array.from({ length: 35 }, (_, i) => ({ bars: page(), kind: kinds[i % kinds.length] }));

// Story wall: 8 x 5 pages. The hit sits in the middle so it has room to lift out.
const COLS = 8;
const HIT = 19;
const storyPages = Array.from({ length: 40 }, (_, i) => ({
  bars: page(),
  kind: kinds[(i * 3) % kinds.length],
  from: i % 3 === 0 ? 'ed' : i % 8 === 5 ? 'mail' : 'moodle',
  label: t.sheets[(i * 5) % t.sheets.length],
}));
---

<Shell lang={lang}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 data-rise>
          {t.hero.h1a.split('\n').map((line) => <span>{line}</span>)}
          <span class="accent">{t.hero.h1b}</span>
        </h1>
        <p class="lead" data-rise>{t.hero.lead}</p>

        <div class="install" data-tabs data-os data-rise>
          <div class="seg" role="tablist">
            {t.hero.tabs.map((label, i) => (
              <button type="button" role="tab" data-tab aria-selected={i === 0 ? 'true' : 'false'}>{label}</button>
            ))}
          </div>
          {t.hero.cmds.map((cmd, i) => (
            <div class="cmd-panel" data-panel hidden={i !== 0}>
              <div class="cmd">
                <span class="prompt" aria-hidden="true">{i < 2 ? '$' : '›'}</span>
                <code>{cmd}</code>
                <button class="copy" type="button" data-copy={cmd} aria-label={t.copy}>
                  <span class="i-copy"><Copy size={15} /></span><span class="i-done"><Check size={15} /></span>
                </button>
              </div>
              <p class="cmd-note">{t.hero.notes[i]}</p>
            </div>
          ))}
        </div>

        <div class="hero-actions" data-rise>
          <a class="btn btn-light" href={link('study-kit/install/')}>{t.hero.primary}<ArrowRight size={16} /></a>
          <a class="btn btn-ghost" href={link('tools/')}>{t.hero.secondary}</a>
        </div>
        <p class="hero-meta" data-rise>{t.hero.meta}</p>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="wall-scene">
          <div class="wall">
            {heroPages.map((p, i) => (
              <div class:list={['pg', `k-${p.kind}`, { hit: i === HERO_HIT }]} style={`--i:${i}`}>
                {p.bars.map((w) => <i style={`width:${w.toFixed(0)}%`}></i>)}
                {i === HERO_HIT && <b>p.14</b>}
              </div>
            ))}
            <div class="sweep"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll story: the wall of pages, step by step -->
  <section class="story" id="how" data-story style={`--cols:${COLS}`}>
    <div class="story-pin">
      <div class="wrap story-grid">
        <div class="story-text">
          <h2>
            <span>{t.story.h2a}</span>
            <span class="soft">{t.story.h2b}</span>
          </h2>
          <div class="steps-wrap">
          <ol class="steps">
            {t.story.steps.map((s, i) => (
              <li data-step-text={i}>
                <span class="n">0{i + 1}</span>
                <div><h3>{s.h}</h3><p>{s.p}</p></div>
              </li>
            ))}
          </ol>
          <div class="progress" aria-hidden="true"><i data-progress></i></div>
          </div>
          <a class="text-link" href={link('study-kit/privacy/')}>{t.story.more}<ArrowRight size={15} /></a>
        </div>

        <div class="stage" aria-hidden="true">
          <svg class="beams" data-beams>
            <defs>
              <linearGradient id="beam" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#c3b8ff" stop-opacity="0.9" />
                <stop offset="1" stop-color="#9fd8ff" stop-opacity="0.15" />
              </linearGradient>
            </defs>
            {t.story.sources.map((s) => <path data-beam={s.id} class:list={{ optional: s.optional }} />)}
          </svg>
          <div class="sources">
            {t.story.sources.map((s) => (
              <div class:list={['source', { optional: s.optional }]} data-source={s.id}><strong>{s.name}</strong><span>{s.note}</span></div>
            ))}
          </div>
          <div class="laptop-label">{t.story.laptop}<em>{t.story.sample}</em></div>

          <div class="query" data-query>
            <span class="q-icon"></span><span class="q-text" data-q-text data-full={t.story.query}></span><span class="caret"></span>
          </div>

          <div class="grid" data-grid>
            {storyPages.map((p, i) => (
              <div class:list={['pg', `k-${p.kind}`, { hit: i === HIT }]} data-pg={i} data-from={p.from}>
                {p.bars.map((w) => <i style={`width:${w.toFixed(0)}%`}></i>)}
                {i === HIT && <b>p.14</b>}
              </div>
            ))}
            <div class="scan" data-scan></div>
          </div>

          <div class="answer" data-answer>
            <div class="a-q">{t.story.query}</div>
            <div class="a-tool"><i></i>monash · {t.story.answer.tool}</div>
            <div class="a-src">
              <span class="a-thumb"><i></i><i></i><i></i></span>
              <div><strong>{t.story.answer.source}</strong><span>{t.story.answer.read}</span></div>
            </div>
            <p class="a-reply">{t.story.answer.reply}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="tools wrap" id="tools">
    <h2 class="section-h" data-rise>{t.tools.h2}</h2>
    <ul class="tool-list" data-rise-group>
      {t.tools.rows.map((r, i) => (
        <li>
          <a href={link(r.href)}>
            <span class="t-n">0{i + 1}</span>
            <span class="t-name">{r.name}</span>
            <span class="t-line">{r.line}</span>
            <span class="t-meta"><em>{t.tools.installLabel}</em>{r.install}<em>{t.tools.runsLabel}</em>{r.runs}</span>
            <span class="t-go"><ArrowUpRight size={20} /></span>
          </a>
        </li>
      ))}
    </ul>
    <ul class="rules" data-rise>
      {t.tools.rules.map((r) => <li>{r}</li>)}
    </ul>
  </section>

  <!-- Let your AI install it -->
  <section class="agent wrap">
    <h2 class="section-h center" data-rise>
      <span>{t.agent.h2a}</span>
      <span class="accent">{t.agent.h2b}</span>
    </h2>
    <p class="agent-p" data-rise>{t.agent.p}</p>
    <div class="cmd cmd-wide" data-rise>
      <span class="prompt" aria-hidden="true">›</span>
      <code>{t.agent.prompt}</code>
      <button class="copy" type="button" data-copy={t.agent.prompt} aria-label={t.copy}>
        <span class="i-copy"><Copy size={15} /></span><span class="i-done"><Check size={15} /></span>
      </button>
    </div>
    <a class="text-link center" href={link('ai-setup/')} data-rise>{t.agent.more}<ArrowRight size={15} /></a>
  </section>
</Shell>

<script>
  // Scroll story. The section is tall; its inner stage is sticky. Progress 0..1 through the
  // section drives four steps: pages arrive, get indexed, one is found, it becomes the answer.
  const story = document.querySelector<HTMLElement>('[data-story]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (story && still) story.classList.add('static');

  if (story && !still) {
    const pages = [...story.querySelectorAll<HTMLElement>('[data-pg]')];
    const hit = story.querySelector<HTMLElement>('.pg.hit')!;
    const scan = story.querySelector<HTMLElement>('[data-scan]')!;
    const qText = story.querySelector<HTMLElement>('[data-q-text]')!;
    const full = qText.dataset.full || '';
    const bar = story.querySelector<HTMLElement>('[data-progress]')!;
    const texts = [...story.querySelectorAll<HTMLElement>('[data-step-text]')];
    const grid = story.querySelector<HTMLElement>('[data-grid]')!;
    const answer = story.querySelector<HTMLElement>('[data-answer]')!;
    const cols = 8;
    const stage = story.querySelector<HTMLElement>('.stage')!;

    // Where each page starts its flight: the centre of its source label (Moodle, Ed or mail) above the grid.
    // offsetLeft/Top ignore transforms, so this can be measured at any point in the animation.
    let origin: { dx: number; dy: number }[] = [];
    const layout = () => {
      const src: Record<string, { x: number; y: number }> = {};
      story.querySelectorAll<HTMLElement>('[data-source]').forEach((el) => {
        const box = el.offsetParent as HTMLElement;
        src[el.dataset.source!] = { x: box.offsetLeft + el.offsetLeft + el.offsetWidth / 2, y: box.offsetTop + el.offsetTop + el.offsetHeight / 2 };
      });
      origin = pages.map((el) => {
        const s = src[el.dataset.from!];
        return { dx: s.x - (grid.offsetLeft + el.offsetLeft + el.offsetWidth / 2), dy: s.y - (grid.offsetTop + el.offsetTop + el.offsetHeight / 2) };
      });
      // Beams: a curve from each label down into the grid.
      const svg = story.querySelector<SVGSVGElement>('[data-beams]')!;
      svg.setAttribute('viewBox', `0 0 ${stage.clientWidth} ${stage.clientHeight}`);
      const mid = grid.offsetLeft + grid.clientWidth / 2;
      const top = grid.offsetTop + grid.clientHeight * 0.35;
      svg.querySelectorAll<SVGPathElement>('[data-beam]').forEach((path) => {
        const s = src[path.dataset.beam!];
        path.setAttribute('d', `M ${s.x} ${s.y + 20} C ${s.x} ${top - 40}, ${mid} ${s.y + 60}, ${mid} ${top}`);
      });
      last = -1;
    };

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    // Spring-like overshoot for pages landing in the grid.
    const back = (x: number) => 1 + 2.2 * Math.pow(x - 1, 3) + 1.2 * Math.pow(x - 1, 2);

    // Progress chases the scroll position instead of jumping to it, so the scene stays smooth
    // when the wheel moves in steps.
    let p = 0;
    let last = -1;
    const render = () => {
      const r = story.getBoundingClientRect();
      const target = clamp(-r.top / (r.height - innerHeight));
      p += (target - p) * 0.16;
      if (Math.abs(target - p) < 0.0004) p = target;
      if (Math.abs(p - last) < 0.0002) return;
      last = p;

      const step = p < 0.27 ? 0 : p < 0.5 ? 1 : p < 0.72 ? 2 : 3;
      story.dataset.step = String(step);
      texts.forEach((el, i) => el.classList.toggle('on', i === step));
      bar.style.transform = `scaleY(${p})`;

      // 1. Sync: each page flies in from its source, in reading order.
      const sync = seg(p, 0.02, 0.26);
      pages.forEach((el, i) => {
        const start = (i / pages.length) * 0.75;
        const k = seg(sync, start, start + 0.25);
        const e = back(k);
        const o = origin[i];
        el.style.opacity = String(Math.min(1, k * 3));
        el.style.setProperty('--x', `${(1 - e) * o.dx}px`);
        el.style.setProperty('--y', `${(1 - e) * o.dy}px`);
        el.style.setProperty('--s', String(0.35 + 0.65 * Math.min(1, e)));
      });

      // 2. Index: a scan line passes down the grid and leaves pages marked as read.
      const idx = seg(p, 0.28, 0.48);
      scan.style.opacity = idx > 0 && idx < 1 ? '1' : '0';
      scan.style.transform = `translateY(${idx * grid.clientHeight}px)`;
      const rows = Math.ceil(pages.length / cols);
      pages.forEach((el, i) => el.classList.toggle('read', Math.floor(i / cols) < idx * rows));

      // 3. Find: the question types out, then every page but one fades.
      const typed = seg(p, 0.46, 0.58);
      qText.textContent = full.slice(0, Math.round(typed * full.length));
      const find = ease(seg(p, 0.56, 0.68));
      grid.style.setProperty('--dim', String(1 - find * 0.8));
      hit.style.setProperty('--glow', String(find));

      // 4. Answer: the page lifts out and the answer card takes its place.
      const lift = ease(seg(p, 0.72, 0.86));
      hit.style.setProperty('--lift', String(lift));
      const ans = seg(p, 0.8, 0.94);
      answer.style.opacity = String(ans);
      if (ans > 0) hit.style.opacity = String(1 - ans);
      answer.style.transform = `translateY(${(1 - back(ans)) * 40}px) scale(${0.96 + 0.04 * ans})`;
    };

    layout();
    addEventListener('resize', layout);

    // Only run while the section is near the screen.
    let running = false;
    const loop = () => { if (!running) return; render(); requestAnimationFrame(loop); };
    new IntersectionObserver(([e]) => {
      const was = running;
      running = e.isIntersecting;
      if (running && !was) requestAnimationFrame(loop);
    }, { rootMargin: '200px 0px' }).observe(story);
  }
</script>
