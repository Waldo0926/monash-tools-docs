---
import Shell from './Shell.astro';
import { Image } from 'astro:assets';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import popup from '../assets/attendance/popup.png';
import confirm from '../assets/attendance/confirm-page.png';
import hubMarksZh from '../assets/hub/marks-zh.png';
import hubMarksEn from '../assets/hub/marks-en.png';
import hubSearchZh from '../assets/hub/search-zh.png';
import hubSearchEn from '../assets/hub/search-en.png';
import edThreads from '../assets/edweb/ed-threads.png';
import edLessons from '../assets/edweb/ed-lessons.png';
import { strings, type Lang } from '../i18n/landing';
import { toolsPage } from '../i18n/tools';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const p = toolsPage[lang];
const zh = lang === 'zh';
const link = (href: string) => (href.startsWith('http') || href.startsWith('/') ? href : `${t.prefix}/${href}`);
const [kit, hub, ed, att, bot] = p.tools;
---

<Shell lang={lang} title={p.title} description={p.description} path="tools/">
  <section class="tp-head wrap">
    <h1 data-rise><span>{p.h1a}</span> <span class="accent">{p.h1b}</span></h1>
    <p data-rise>{p.lead}</p>
  </section>

  <div class="wrap tp-layout">
  <nav class="tp-side" aria-label={p.title} data-tp-side>
    <ol>
      {p.tools.map((tool, n) => <li><a href={`#${tool.id}`} data-tp-link={tool.id}><span>0{n + 1}</span>{tool.name}</a></li>)}
    </ol>
  </nav>
  <div class="tp-main">
  {p.tools.map((tool, n) => (
    <section class="tp" id={tool.id} data-tp={tool.id}>
        <div data-rise>
          <p class="tp-kicker"><span>0{n + 1}</span>{tool.name}</p>
          <h2>{tool.h2}</h2>
          <p class="tp-desc">{tool.desc}</p>
          <dl class="facts">
            {tool.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          {tool.cmd && (
            <div class="cmd">
              <span class="prompt" aria-hidden="true">$</span>
              <code>{tool.cmd}</code>
              <button class="copy" type="button" data-copy={tool.cmd} aria-label={p.copy}>
                <span class="i-copy"><Copy size={15} /></span><span class="i-done"><Check size={15} /></span>
              </button>
            </div>
          )}
          <div class="tp-links">
            {tool.links.map(([label, href]) => <a href={link(href)}>{label}</a>)}
          </div>
        </div>

        <figure class="demo" data-tabs data-rise>
          <div class="demo-tabs" role="tablist">
            {tool.tabs.map((label, i) => (
              <button type="button" role="tab" data-tab aria-selected={i === 0 ? 'true' : 'false'}>{label}</button>
            ))}
          </div>

          {n === 0 && (
            <>
              <div class="demo-body" data-panel>
<pre class="term"><span class="c">$</span> <span class="b">monash grep "monad"</span>
[FIT2102] Week 8 Lecture Slides  @ p.14
    …a «monad» wraps a value and gives you bind…

[FIT2102] Course notes: Monads  @ p.2
    …the Maybe «monad» handles a missing value…

[FIT2102] Week 8 Lecture  @ 41:20<i class="w2">（</i><i class="w2">视</i><i class="w2">频</i> Week 8 Lecture.mp4<i class="w2">）</i>
    …so this is why we call Maybe a «monad»…

<span class="c">$</span> <span class="b">monash due</span>
<i class="w2">时</i><i class="w2">间</i>             <i class="w2">剩</i><i class="w2">余</i>    <i class="w2">课</i><i class="w2">程</i>     <i class="w2">类</i><i class="w2">型</i>  <i class="w2">内</i><i class="w2">容</i>
───────────────  ──────  ───────  ────  ────────────
10-27 Mon 23:55  <span class="w">2 <i class="w2">天</i><i class="w2">后</i></span>  FIT2102  <i class="w2">截</i><i class="w2">止</i>  Assignment 2
10-29 Wed 23:55  4 <i class="w2">天</i><i class="w2">后</i>  FIT2109  <i class="w2">截</i><i class="w2">止</i>  Quiz 6
10-31 Fri 17:00  6 <i class="w2">天</i><i class="w2">后</i>  FIT2014  <i class="w2">截</i><i class="w2">止</i>  Lab 9 report</pre>
              </div>
              <div class="demo-body" data-panel hidden>
                <div class="chat" style="font-size:13.5px">
                  <div class="bubble me" style="background:#e8e6df">{zh ? 'monad 在哪份资料里讲过？' : 'Where were monads covered?'}</div>
                  <div class="a-tool"><i></i>moodle_search_content</div>
                  <div class="ui-row"><span class="ui-tag">PDF</span><div class="ui-main"><strong>Week 8 Lecture Slides</strong><span>{zh ? '第 14 页' : 'Page 14'}</span></div></div>
                  <div class="ui-row"><span class="ui-tag">{zh ? '录播' : 'Video'}</span><div class="ui-main"><strong>Week 8 Lecture</strong><span>41:20</span></div></div>
                  <p class="a-reply" style="margin-top:6px">{zh ? '第 8 周课件第 14 页开始讲，录播 41:20 讲了 Maybe 的例子。要我读一下那几页，再给你讲一遍吗？' : 'Week 8 introduces it on page 14 of the slides, and the lecture explains the Maybe example at 41:20. Want me to read those pages and walk you through it?'}</p>
                </div>
              </div>
            </>
          )}

          {n === 1 && (
            <>
              <div class="demo-body shot" data-panel>
                <Image src={zh ? hubMarksZh : hubMarksEn} alt={zh ? 'Monash Hub 的 WAM / GPA 计算器，五门课按级别分组，右边是 WAM 和 GPA' : 'Monash Hub WAM / GPA calculator with five units grouped by level and the WAM and GPA summary'} widths={[700, 1100, 2560]} sizes="(max-width: 900px) 100vw, 900px" />
              </div>
              <div class="demo-body shot" data-panel hidden>
                <Image src={zh ? hubSearchZh : hubSearchEn} alt={zh ? 'Monash Hub 搜索 census：先给官方来源的答案，下面是官方指南' : 'Monash Hub search for census: an answer with its official sources, then the official guides'} widths={[700, 1100, 2560]} sizes="(max-width: 900px) 100vw, 900px" />
              </div>
            </>
          )}

          {n === 2 && (
            <>
              <div class="demo-body shot" data-panel>
                <Image src={edThreads} alt={zh ? 'Ed Web 帖子页：每条帖子一句话结论，老师答、截止变动、待解答都有标签' : 'Ed Web posts view: one line per post, with labels for staff answers, deadline changes and unanswered questions'} widths={[700, 1100, 1720]} sizes="(max-width: 900px) 100vw, 900px" />
              </div>
              <div class="demo-body shot" data-panel hidden>
                <Image src={edLessons} alt={zh ? 'Ed Web 课程内容页：按周列出每节 lesson 的状态、资料和截止时间' : 'Ed Web lessons view: each lesson by week with its status, files and due date'} widths={[700, 1100, 1720]} sizes="(max-width: 900px) 100vw, 900px" />
              </div>
            </>
          )}

          {n === 3 && (
            <>
              <div class="demo-body shot" data-panel>
                <Image src={confirm} alt={zh ? '签到助手确认页：每节课一张卡片，只提交你勾选并确认上过的课' : 'The confirm page: one card per class, and only ticked classes you confirm are submitted'} widths={[700, 1100, 2070]} sizes="(max-width: 900px) 100vw, 900px" />
              </div>
              <div class="demo-body" data-panel hidden style="display:grid;place-items:center">
                <Image src={popup} alt={zh ? '扩展弹窗：本周找到 5 个里的 4 个签到码' : 'The extension popup showing 4 of 5 codes found this week'} width={422} style="border-radius:12px;max-width:100%;height:auto;box-shadow:0 8px 30px -10px rgba(0,0,0,.25)" />
              </div>
            </>
          )}

          {n === 4 && (
            <>
              <div class="demo-body" data-panel>
                <div class="wx chat">
                  <div class="bubble me">宿舍晚上几点门禁？</div>
                  <div class="bubble bot">这个问题我还答不上来 🙏 已经转给 Waldo，他补充答案后，你再给我发任意一条消息就能看到。<br />等的时候可以先在 Monash Hub 搜搜看：<span class="lnk">https://monashhub.secureview.tech/search?q=%E5%AE%BF%E8%88%8D%E6%99%9A%E4%B8%8A%E5%87%A0%E7%82%B9%E9%97%A8%E7%A6%81%EF%BC%9F</span><br />📚 马莫百科往期文章（按主题分类）：<span class="lnk">https://monashhub.secureview.tech/mamo</span></div>
                </div>
              </div>
              <div class="demo-body" data-panel hidden>
                <div class="wx chat">
                  <div class="bubble me">好的谢谢</div>
                  <div class="bubble bot">不客气 😊 还有问题随时问我。</div>
                </div>
              </div>
            </>
          )}
          <figcaption class="demo-note">{tool.note}</figcaption>
        </figure>
    </section>
  ))}
  </div>
  </div>
</Shell>

<script>
  // Highlight the tool you are reading in the side index.
  const links = new Map([...document.querySelectorAll<HTMLElement>('[data-tp-link]')].map((a) => [a.dataset.tpLink, a]));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a) => a.removeAttribute('aria-current'));
      links.get((e.target as HTMLElement).dataset.tp)?.setAttribute('aria-current', 'true');
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('[data-tp]').forEach((el) => io.observe(el));
</script>
